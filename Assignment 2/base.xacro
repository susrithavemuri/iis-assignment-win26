

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="robot_base" params="base_radius base_height">

        <link name="base_link">

            <visual>
                <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="${base_radius}" length="${base_height}"/>
                </geometry>
                <material name="grey">
                    <color rgba="0.5 0.5 0.5 1.0"/>
                </material>
            </visual>

            <collision>
                <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="${base_radius}" length="${base_height}"/>
                </geometry>
            </collision>

        </link>

    </xacro:macro>

</robot>
