
<robot name="domestic_assistant" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Import the three components -->
    <xacro:include filename="base.xacro"/>
    <xacro:include filename="arm.xacro"/>
    <xacro:include filename="gripper.xacro"/>

    <!-- Robot dimensions in metres -->
    <xacro:property name="base_radius" value="0.15"/>
    <xacro:property name="base_height" value="0.20"/>

    <xacro:property name="link1_length" value="0.80"/>
    <xacro:property name="link2_length" value="0.60"/>

    <xacro:property name="gripper_span" value="0.14"/>

    <!-- Create the base -->
    <xacro:robot_base
        base_radius="${base_radius}"
        base_height="${base_height}"/>

    <!-- Create the arm -->
    <xacro:robot_arm
        base_height="${base_height}"
        link1_length="${link1_length}"
        link2_length="${link2_length}"/>

    <!-- Create the gripper -->
    <xacro:robot_gripper
        gripper_span="${gripper_span}"/>

    <!-- Attach the vertical rail to the base -->
    <joint name="base_to_rail" type="fixed">
        <parent link="base_link"/>
        <child link="vertical_rail"/>
        <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
    </joint>

    <!-- Attach the gripper to the end of the arm -->
    <joint name="arm_to_gripper" type="fixed">
        <parent link="horizontal_arm"/>
        <child link="gripper_base"/>
        <origin xyz="${link2_length} 0 0" rpy="0 0 0"/>
    </joint>

</robot>
