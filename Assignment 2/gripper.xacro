

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="robot_gripper" params="gripper_span">

        <!-- Gripper base -->
        <link name="gripper_base">
            <visual>
                <geometry>
                    <box size="0.08 0.12 0.04"/>
                </geometry>
                <material name="black">
                    <color rgba="0.1 0.1 0.1 1"/>
                </material>
            </visual>
        </link>

        <!-- Left finger -->
        <link name="left_finger">
            <visual>
                <geometry>
                    <box size="0.02 0.02 0.10"/>
                </geometry>
                <origin xyz="0 0 -0.05"/>
                <material name="grey">
                    <color rgba="0.6 0.6 0.6 1"/>
                </material>
            </visual>
        </link>

        <joint name="left_finger_joint" type="prismatic">
            <parent link="gripper_base"/>
            <child link="left_finger"/>
            <origin xyz="0 ${gripper_span/2} 0"/>
            <axis xyz="0 -1 0"/>
            <limit lower="0" upper="0.02" effort="20" velocity="0.1"/>
        </joint>

        <!-- Right finger -->
        <link name="right_finger">
            <visual>
                <geometry>
                    <box size="0.02 0.02 0.10"/>
                </geometry>
                <origin xyz="0 0 -0.05"/>
                <material name="grey">
                    <color rgba="0.6 0.6 0.6 1"/>
                </material>
            </visual>
        </link>

        <joint name="right_finger_joint" type="prismatic">
            <parent link="gripper_base"/>
            <child link="right_finger"/>
            <origin xyz="0 ${-gripper_span/2} 0"/>
            <axis xyz="0 1 0"/>
            <limit lower="0" upper="0.02" effort="20" velocity="0.1"/>
        </joint>

    </xacro:macro>

</robot>
